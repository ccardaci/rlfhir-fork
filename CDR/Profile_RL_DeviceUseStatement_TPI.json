          {
            "code": "Period"
          }
        ],
        "definition": "Rappresenta la data e ora in cui il dispositivo è stato impiantato, sostituito/espiantato."
      },
      {
        "id": "DeviceUseStatement.timing[x].start",
        "path": "DeviceUseStatement.timing[x].start",
        "min": 0,
        "max": "1"
      },
      {
        "id": "DeviceUseStatement.timing[x].end",
        "path": "DeviceUseStatement.timing[x].end",
        "min": 0,
        "max": "1"
      },
      {
        "id": "DeviceUseStatement.extension:struttura",
        "path": "DeviceUseStatement.extension",
        "sliceName": "struttura",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
